# .env
# 容器名称
CONTAINER_NAME=myztplanet

# 镜像地址 (根据是否使用代理切换)
# 无代理: xubiaolin/zerotier-planet:latest
# 有代理: xubiaolin/zerotier-planet:latest (脚本逻辑中两者相同，若有其他源请在此修改)
DOCKER_IMAGE=xubiaolin/zerotier-planet:latest

# 端口配置 (请根据实际情况修改，确保未被占用)
ZT_PORT=9994
API_PORT=3443
FILE_PORT=3000

# IP 地址配置 (自动获取或手动填写)
IP_ADDR4=你的公网 IPv4 地址
IP_ADDR6=你的公网 IPv6 地址 (若无留空)

# 数据持久化路径 (相对于 docker-compose.yml 所在目录)
DATA_PATH=./data/zerotier
CONFIG_PATH=${DATA_PATH}/config
DIST_PATH=${DATA_PATH}/dist
ZTNCUI_PATH=${DATA_PATH}/ztncui
ONE_PATH=${DATA_PATH}/one
